# Copie para .env (o .env NÃO vai para o git).

# Banco. O "?schema=asseit" separa as tabelas deste app das do healthPool original,
# então os dois podem usar o MESMO servidor PostgreSQL sem se misturar.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/healthpool?schema=asseit

# Código de acesso único da equipe. O app pede uma vez e guarda no aparelho.
# DEIXE EM BRANCO: o servidor gera um código aleatório na 1ª execução, salva em data/access-key
# e mostra no log. (Opcional: fixe um próprio, mínimo 12 caracteres.)
# ACCESS_KEY=

PORT=5000
